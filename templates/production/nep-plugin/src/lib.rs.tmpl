use thenodes::config::ConfigDefaults;
use thenodes::network::message::{Message, MessageType};
use thenodes::plugin_host::{
    NativeRegistrar, Plugin, PluginContext, PluginError, PluginRegistrationError,
};
use thenodes::realms::RealmInfo;

/// {{APP_NAME}} Plugin
///
/// This plugin demonstrates the NEP (Node-Embedded Plugin) pattern.
/// It is designed to be compiled as a dynamic library and loaded by TheNodes.
/// Its callbacks run on the library's own runtime; host functionality is
/// reached through `PluginContext` host services.
pub struct {{APP_NAME_PASCAL}}Plugin;

impl {{APP_NAME_PASCAL}}Plugin {
    pub fn new() -> Self {
        Self
    }
}

impl Default for {{APP_NAME_PASCAL}}Plugin {
    fn default() -> Self {
        Self::new()
    }
}

#[async_trait::async_trait]
impl Plugin for {{APP_NAME_PASCAL}}Plugin {
    fn plugin_id(&self) -> &'static str {
        "{{APP_NAME}}"
    }

    /// Finish local initialization before the host activates the node.
    async fn on_start(&self, ctx: &PluginContext) -> Result<(), PluginError> {
        let data_dir = ctx.plugin_data_dir().await?;
        log::info!("{{APP_NAME}} using data directory {}", data_dir.display());

        // Long-running work belongs in a managed task. Sends are allowed only
        // after activation, so the task waits for it and stops on cancellation.
        ctx.spawn_task("{{APP_NAME}}-status", |task| async move {
            if task.activated().await.is_err() {
                return Ok(());
            }
            let mut interval = tokio::time::interval(std::time::Duration::from_secs(60));
            loop {
                tokio::select! {
                    _ = interval.tick() => log::debug!("{{APP_NAME}} is running"),
                    _ = task.cancelled() => return Ok(()),
                }
            }
        })
        .map_err(|error| PluginError::new(error.to_string()))?;
        Ok(())
    }

    /// Handle incoming network messages, one at a time in admission order.
    async fn on_message(&self, message: &Message, _ctx: &PluginContext) {
        if let MessageType::Extension { kind } = &message.msg_type {
            println!("{{APP_NAME}} received extension message: {kind}");
        }
    }

    /// Release resources. Also runs after a failed start, so tolerate
    /// incomplete initialization.
    async fn on_stop(&self, _ctx: &PluginContext) -> Result<(), PluginError> {
        Ok(())
    }

    /// Receive only the extension kinds handled by this plugin.
    fn subscribed_extension_kinds(&self) -> Option<&[&str]> {
        Some(&["{{APP_NAME}}.message"])
    }

    /// Handle user prompt input for this plugin.
    async fn on_prompt(&self, input: &str, _ctx: &PluginContext) -> Option<String> {
        Some(format!("{{APP_NAME}} plugin received: {input}"))
    }

    /// Set the prompt prefix for this plugin's commands.
    fn prompt_prefix(&self) -> Option<&str> {
        Some("{{APP_NAME}}")
    }

    /// Provide configuration defaults for this plugin.
    fn early_config_defaults(&self) -> Option<ConfigDefaults> {
        Some(ConfigDefaults {
            realm: Some(RealmInfo::new("{{APP_REALM}}", "1")),
            app_name: Some("{{APP_NAME}} Network".to_string()),
            ..Default::default()
        })
    }
}

/// Register this library's handlers. All handlers of one library share its runtime.
fn register(registrar: &mut NativeRegistrar) -> Result<(), PluginRegistrationError> {
    registrar.register(Box::new({{APP_NAME_PASCAL}}Plugin::new()));
    Ok(())
}

// Exports `thenodes_plugin_abi_version` and `register_plugin` (plugin ABI 4).
thenodes::export_plugin!(register);
